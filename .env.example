# mktlink. Все переменные с префиксом MKTLINK_, кроме отмеченных.
# Ни один модуль пакета не читает os.environ напрямую — только settings.py.

# --- ручка ---------------------------------------------------------------
# Потолок ответа. Диапазон 5000…30000, дефолт 30000.
#
# Поднят с 15000 по замеру 2026-09-03: карточка Ozon через скрейпинг-API
# отдаётся 9.1–25.6 с, и при потолке 15 с укладывалась примерно в половине
# случаев. Тридцать секунд покрывают самое медленное наблюдение с запасом.
#
# Обычный запрос при попадании в кэш идёт за единицы миллисекунд при любой
# настройке, а Wildberries — за 0.6 с: потолок оплачивает только Ozon.
MKTLINK_RESPONSE_BUDGET_MS=30000

# --- хранилище -----------------------------------------------------------
MKTLINK_DB_PATH=data/mktlink.sqlite
MKTLINK_FORGE_SOCKET=data/forge.sock

# --- proxy6.net ----------------------------------------------------------
# Ключ из личного кабинета. Сидит в PATH запроса, поэтому вырезается из логов.
MKTLINK_PROXY6_API_KEY=
MKTLINK_PROXY6_COUNTRY=ru
# Период закупки. Короткий намеренно: неудачная покупка должна дёшево
# истечь, а не висеть оплаченной месяц.
MKTLINK_PROXY6_PERIOD_DAYS=7

# --- Яндекс.Маркет -------------------------------------------------------
# Регион форсируется на каждом исходящем, поэтому в ключ кэша не входит.
MKTLINK_YM_REGION_ID=213
# Ступень рендера. По умолчанию ВЫКЛЮЧЕНА: браузера на пути запроса не бывает.
# Включение стоит +5 с к p95 и требует явного решения.
MKTLINK_YM_RENDER_ENABLED=false

# --- эксплуатация --------------------------------------------------------
MKTLINK_LOG_LEVEL=INFO
MKTLINK_METRICS_ENABLED=true
